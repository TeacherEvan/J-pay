# Client-side Convex deployment URL (public). `npx convex dev` writes this into .env.local automatically.
NEXT_PUBLIC_CONVEX_URL=

# Convex Auth JWT signing material — set via `npx convex env set` or the dashboard, NEVER in this repo.
JWT_PRIVATE_KEY=
JWKS=

# HMAC secret for device tokens — set via `npx convex env set DEVICE_TOKEN_SECRET <random>`.
DEVICE_TOKEN_SECRET=

# One-time bootstrap key for creating the first moderator (see convex/users.ts).
BOOTSTRAP_KEY=

# Vercel deploy key placeholder — never fill.
CONVEX_DEPLOY_KEY=
