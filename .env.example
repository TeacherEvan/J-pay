# Client-side Convex deployment URL (public). `npx convex dev` writes this into .env.local automatically.
NEXT_PUBLIC_CONVEX_URL=

# --- Supabase (docs/SUPABASE-LINK.md) ---
# Project base URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) — browser-safe, governed by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon JWT — only needed if you are not using the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service key. Bypasses RLS on every table: never expose it to the
# client and never prefix it with NEXT_PUBLIC_. Prefer the new-style
# `sb_secret_…` key; the legacy service_role JWT also works.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Convex Auth JWT signing material — set via `npx convex env set` or the dashboard, NEVER in this repo.
JWT_PRIVATE_KEY=
JWKS=

# HMAC secret for device tokens — set via `npx convex env set DEVICE_TOKEN_SECRET <random>`.
DEVICE_TOKEN_SECRET=

# One-time bootstrap key for creating the first moderator (see convex/users.ts).
BOOTSTRAP_KEY=

# Vercel deploy key placeholder — never fill.
CONVEX_DEPLOY_KEY=

# Runtime features (set via Convex dashboard / `npx convex env set`)
VAPID_SUBJECT=

VAPID_PUBLIC_KEY=

VAPID_PRIVATE_KEY=

PAYROLL_DEFAULT_RATE=

PAYROLL_CURRENCY=
