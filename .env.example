# J-Pay environment — Supabase-backed deployment (NOT Convex)
# Copy to .env.local and fill in. Never commit .env.local.
# Migrations are owner-applied SQL in the editor — see README + docs/ops/.

# --- Supabase ---
# Project base URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…) — browser-safe, governed by RLS (default-deny).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon JWT — only needed if you are not using the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret key. Bypasses RLS: never expose it to the client and never
# prefix it with NEXT_PUBLIC_. Prefer the new-style `sb_secret_…` key; the legacy
# service_role JWT in SUPABASE_SERVICE_ROLE_KEY also works.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret for device tokens — `openssl rand -hex 32`.
DEVICE_TOKEN_SECRET=

# One-time bootstrap key for creating the first moderator (scripts/create-moderator.mjs).
BOOTSTRAP_KEY=
# Optional: master password flow for creating a transient moderator.
MASTER_PASSWORD=

# Retention cron bearer — only needed if you enable the archived pg_cron jobs
# (supabase/migrations/archive/0003_retention_crons.OWNER_ONLY.sql). `openssl rand -hex 32`.
CRON_SECRET=
# Bearer for the smoke-test endpoint. `openssl rand -hex 16`.
SMOKE_TEST_KEY=

# Runtime features
# Set to 1 ONLY for demo/persona preview deployments. Never in production payroll contexts.
DEMO_MODE=
# Web push (optional). VAPID_SUBJECT e.g. mailto:ops@example.com
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Payroll configuration. PAYROLL_STRATEGY must be one of:
#   flat | bcea | dailyOvertime | flsa | wtr_uk
# A missing/invalid value or a non-positive PAYROLL_DEFAULT_RATE fails payroll LOUDLY
# (RATE_NOT_CONFIGURED / INVALID_PAYROLL_STRATEGY) instead of paying R0.00 silently.
PAYROLL_DEFAULT_RATE=
PAYROLL_CURRENCY=
PAYROLL_STRATEGY=
